# Starbrite .gitignore

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.tsbuildinfo

# Tool caches and reports
.vite/
.vitest/
coverage/
.eslintcache

# Calibration sweep output (the committed copy lives in docs/04-world-units-and-scale.md)
calibration-output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (none are needed today; this keeps future secrets out of git)
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editors and IDEs (shared VS Code settings are kept)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Local-only notes and scratch space

.local/

# Note: package-lock.json is intentionally NOT ignored; commit it for reproducible installs.
# Note: public/constellations/ is intentionally NOT ignored; constellations are source data.